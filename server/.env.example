# 2in API server — env vars

# Server
PORT=3001
HOST=0.0.0.0
LOG_LEVEL=info
NODE_ENV=development

# Twitter OAuth 2.0 (PKCE flow)
# Register an app at https://developer.twitter.com → User authentication settings
# - Type: "Web App, Automated App or Bot" (confidential) OR "Native App" (public PKCE)
# - Callback URL must exactly match TWITTER_REDIRECT_URI below
# - Scopes needed: tweet.read, users.read, offline.access
TWITTER_CLIENT_ID=
TWITTER_CLIENT_SECRET=
TWITTER_REDIRECT_URI=http://localhost:5173/onboarding

# Allowed origins for CORS (comma-separated). Leave * for dev convenience.
CORS_ORIGINS=http://localhost:5173

# === 0G Compute — preferred path: Router (Direct API mode) ===
# Get an API key at https://pc.testnet.0g.ai → API Reference → Create API key.
# Bearer auth, OpenAI-compatible streaming. Top up the dashboard balance with
# 0G from your wallet (see https://faucet.0g.ai for testnet funds).
ZG_ROUTER_URL=https://router-api-testnet.integratenetwork.work/v1/chat/completions
ZG_ROUTER_API_KEY=

# === 0G Compute — fallback: broker (wallet-signed per-call) ===
# Used only if ZG_ROUTER_API_KEY is unset. The 2.0.0 SDK has account-setup
# ceremony that may require manual transferFund + acknowledgeProviderSigner
# on first run; Router is simpler.
BROKER_PRIVATE_KEY=
BROKER_RPC=https://evmrpc-testnet.0g.ai

# Default models. Currently testnet only serves qwen/qwen-2.5-7b-instruct
# (see pc.testnet.0g.ai). Update if more models become available.
DIRECTOR_MODEL=qwen/qwen-2.5-7b-instruct
SPECIALIST_MODEL=qwen/qwen-2.5-7b-instruct

# === 0G Compute — image edit (qwen-image-edit-2511) ===
# Optional dedicated provider for the image.edit tool (object-aware, pixel-true).
# Each 0G provider issues its own app-sk-* token bound to its URL + model;
# the chat key does NOT work here. Get the provider URL via the inference
# contract (set ZG_IMAGE_EDIT_PROVIDER_ADDRESS) or paste the URL directly.
# Without these set, image.edit falls back to ffmpeg-filter mode (still
# pixel output, but global only — no object masking).
ZG_IMAGE_EDIT_PROVIDER_URL=
ZG_IMAGE_EDIT_PROVIDER_ADDRESS=
ZG_IMAGE_EDIT_API_KEY=
ZG_IMAGE_EDIT_MODEL=qwen/qwen-image-edit-2511

# === 0G Storage (Indexer + KV) ===
# Same mock-fallback as compute: without a key, uploads return deterministic
# fake hashes and KV is in-memory. Wallet must be funded on Galileo testnet.
STORAGE_PRIVATE_KEY=
STORAGE_RPC=https://evmrpc-testnet.0g.ai
STORAGE_INDEXER=https://indexer-storage-testnet-turbo.0g.ai
STORAGE_GATEWAY=https://indexer-storage-turbo.0g.ai

# === 0G Chain (TwinINFT) ===
# Deploy via contracts/script/Deploy.s.sol → paste address here.
# Without it, /api/chain/* returns mock state so the demo still works.
CHAIN_CONTRACT_ADDRESS=
CHAIN_RPC=https://evmrpc-testnet.0g.ai
CHAIN_ID=16602
CHAIN_EXPLORER=https://chainscan-galileo.0g.ai
