# Production env for the deployed @2in/server (Render / Fly).
#
# Set these in:
#   Render: dashboard → Environment → Add Env Variable
#     OR via render.yaml `sync: false` rows you fill in the dashboard
#   Fly: `fly secrets set <KEY>=<VALUE>`

# Server
PORT=3001                                # Render/Fly inject their own; this is a dev fallback
HOST=0.0.0.0
NODE_ENV=production
LOG_LEVEL=info

# Browser origins allowed to hit the API (Vercel domain + any custom domain).
# Comma-separated. Use * only if you accept all origins (NOT recommended).
CORS_ORIGINS=https://your-vercel-app.vercel.app,https://2in.your-domain.com

# Twitter app — register the production redirect at developer.twitter.com.
TWITTER_CLIENT_ID=
TWITTER_CLIENT_SECRET=
TWITTER_REDIRECT_URI=https://your-vercel-app.vercel.app/onboarding

# 0G Compute — leave blank for mock; set for real broker calls.
BROKER_PRIVATE_KEY=
BROKER_RPC=https://evmrpc-testnet.0g.ai
DIRECTOR_MODEL=gpt-oss-120b
SPECIALIST_MODEL=qwen-3.6-plus

# 0G Storage — leave blank for mock; set for real Indexer uploads.
STORAGE_PRIVATE_KEY=
STORAGE_RPC=https://evmrpc-testnet.0g.ai
STORAGE_INDEXER=https://indexer-storage-testnet-turbo.0g.ai
STORAGE_GATEWAY=https://indexer-storage-turbo.0g.ai

# 0G Chain — paste the deployed contract address from `forge script ... --broadcast`.
CHAIN_CONTRACT_ADDRESS=
CHAIN_RPC=https://evmrpc-testnet.0g.ai
CHAIN_ID=16602
CHAIN_EXPLORER=https://chainscan-galileo.0g.ai
