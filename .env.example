# Root reference. The actual envs live in `web/.env` and `server/.env`.
# This file documents what each side needs.

# ===== web (Vite) — copy into web/.env =====
# Privy app id from https://dashboard.privy.io
# VITE_PRIVY_APP_ID=
# Optional: API base override. Defaults to /api which dev-proxies to :3001.
# VITE_API_BASE=

# ===== server (Fastify) — copy into server/.env =====
# Twitter OAuth 2.0 — register at https://developer.twitter.com
# TWITTER_CLIENT_ID=
# TWITTER_CLIENT_SECRET=
# TWITTER_REDIRECT_URI=http://localhost:5173/onboarding
# CORS_ORIGINS=http://localhost:5173
# PORT=3001
