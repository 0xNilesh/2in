# 2in web — env vars (Vite-side; only VITE_-prefixed values are exposed to the bundle)

# Privy app id — https://dashboard.privy.io → App settings → API keys
VITE_PRIVY_APP_ID=

# Optional: backend URL override (defaults to /api which Vite proxies to :3001 in dev)
VITE_API_BASE=

# Once contracts are deployed (cd contracts && forge script ...), paste the
# TwinINFT address. Without it, the mint flow runs in mock mode (realistic
# tx hashes, deterministic state) so the demo works without a deployment.
VITE_CHAIN_CONTRACT_ADDRESS=
VITE_CHAIN_RPC=https://evmrpc-testnet.0g.ai
VITE_CHAIN_ID=16602
VITE_CHAIN_EXPLORER=https://chainscan-galileo.0g.ai
