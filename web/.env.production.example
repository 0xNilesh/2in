# Production env for the deployed Vercel build.
#
# Set these in:
#   Vercel dashboard → Project → Settings → Environment Variables
# OR via:
#   vercel env add <KEY> production

# Privy app id from https://dashboard.privy.io
VITE_PRIVY_APP_ID=

# Absolute URL of the deployed @2in/server (Render / Fly).
# Required when web + server are on different origins (which they are
# in production). The dev pattern (Vite proxy /api → :3001) doesn't
# apply here, so VITE_API_BASE must be set or the SPA hits a 404.
VITE_API_BASE=https://2in-server.example.com

# Deployed TwinINFT contract address — paste the value `forge script ...
# --broadcast` printed.
VITE_CHAIN_CONTRACT_ADDRESS=
VITE_CHAIN_RPC=https://evmrpc-testnet.0g.ai
VITE_CHAIN_ID=16602
VITE_CHAIN_EXPLORER=https://chainscan-galileo.0g.ai
